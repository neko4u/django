# ============================================================
# 构建上下文排除清单
#
# 不加这个文件，`COPY . .` 会把下面这些东西一起塞进镜像：
#   .git     243MB
#   venv38   ~200MB（宿主机 Python 环境，进容器会污染运行时）
#   media / downloads  用户数据，可能几百 MB
# 镜像会从 300MB 涨到 800MB 以上，且构建慢一个数量级。
# ============================================================

# ---------- 版本控制 ----------
.git
.gitattributes

# ---------- 虚拟环境（绝不能用宿主机的） ----------
venv
venv38

# ---------- Python 缓存与构建产物 ----------
__pycache__
*.py[cod]
*.egg-info
build
dist
.eggs

# ---------- 运行时数据（容器里走挂载卷，不进镜像） ----------
staticfiles
media
downloads
logs
*.log
*.log.*

# ---------- 本地备份与临时文件 ----------
.backup
*.bak.*
*.tmp
*.swp

# ---------- 本地开发配置（里面可能有密钥） ----------
.env
.env.*
local_settings.py

# ---------- IDE ----------
.idea
.vscode

# ---------- 文档与编排文件（不进镜像，减小体积） ----------
docs
scripts
README.md
AGENTS.md
docker-compose.yml
Dockerfile
.dockerignore
