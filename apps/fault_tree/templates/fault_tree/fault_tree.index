{% extends "base.html" %}
{% load static %}

{% block title %}故障树{% endblock %}

{% block content %}
<link rel="stylesheet" href="{% static 'fault_tree/css/fault_tree.css' %}">
<script src="https://cdn.jsdelivr.net/npm/vis-network@9.1.6/dist/vis-network.min.js"></script>

<div class="ft-header">
    <button class="btn-toggle" id="btn-toggle-left" title="文档列表">☰</button>
    <h2>故障树决策系统</h2>
    <span class="mode-badge view" id="mode-badge" title="点击切换模式">只读</span>
    <button class="btn-toggle" id="btn-toggle-right" title="节点详情">☰</button>
</div>

<div class="ft-layout">
    <!-- 左侧文档列表 -->
    <div class="ft-left" id="left-panel">
        <div class="ft-left-search">
            <input type="text" id="doc-search" placeholder="搜索文档...">
        </div>
        <div class="ft-doc-list" id="doc-list">
            <div style="padding:20px;text-align:center;color:var(--text-secondary)">加载中...</div>
        </div>
        <div class="ft-left-footer edit-only">
            <button id="btn-new-doc">+ 新建文档</button>
        </div>
    </div>

    <!-- 中间画布 -->
    <div class="ft-center" id="center-panel">
        <div class="ft-toolbar edit-only">
            <button class="primary" id="btn-add-node">+ 节点</button>
            <button id="btn-add-edge">+ 连线</button>
            <button id="btn-auto-layout">自动布局</button>
            <button id="btn-fit">适应画面</button>
        </div>
        <div class="ft-canvas-wrap">
            <div class="ft-graph-search">
                <input type="text" id="graph-search" placeholder="搜索节点... (Ctrl+K)">
                <div class="search-results" id="search-results"></div>
            </div>
            <div id="ft-network"></div>
        </div>
    </div>

    <!-- 右侧拖拽分隔条 -->
    <div class="ft-resize-handle" id="resize-handle"></div>

    <!-- 右侧节点详情 -->
    <div class="ft-right" id="right-panel">
        <div class="ft-detail-header">
            <h3>节点详情</h3>
            <button class="btn-toggle" id="btn-close-right">✕</button>
        </div>
        <div class="ft-detail-body" id="detail-body">
            <p style="color:var(--text-secondary);text-align:center;margin-top:80px;">点击节点查看详情</p>
        </div>
    </div>
</div>

<!-- 模态框 (动态创建内容) -->
<div class="modal-overlay" id="modal-overlay" style="display:none;">
    <div class="modal-box" id="modal-box"></div>
</div>

<script src="{% static 'fault_tree/js/fault_tree.js' %}"></script>
{% endblock %}
